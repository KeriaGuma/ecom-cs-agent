# 复制为 .env 后填写。不要把 .env 提交到 Git。

# ===== 模型配置（OpenAI 兼容接口）=====
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-flash
# 多 Agent 对照实验使用的调度模型
ROUTER_MODEL=deepseek-flash
# DeepSeek 默认开启思考模式；带工具调用时通用客户端不回传 reasoning_content，故默认关闭思考
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}

# 切换为阿里云百炼（通义千问）示例：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_MODEL=qwen-plus
# ROUTER_MODEL=qwen-flash
# LLM_EXTRA_BODY={}

LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# ===== 知识库混合检索（Hybrid RAG）=====
# 向量与重排模型：阿里云百炼 DashScope 接口。未配置时自动降级为本地 BM25 检索
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 重排策略：0 不重排 / llm 对话模型重排 / model 专用 Cross-Encoder 重排模型（推荐）
RAG_RERANK=model
RAG_MIN_SCORE=0.0

# ===== 业务与安全护栏参数 =====
REFUND_AUTO_APPROVE_LIMIT=500
# 订单工具来源：local（进程内）/ mcp（stdio 子进程）/ mcp-http（独立 HTTP MCP 服务 + 双层鉴权）
ORDER_TOOLS=local
# MCP_URL=http://127.0.0.1:8765/mcp
# MCP_TOKEN=
# MCP_USER_KEY=
PII_MASK=1
ADDRESS_GUARD=1
UNSUPPORTED_RULE=1
CLAIM_CHECK=1
MEMORY_SUMMARY=1
VISION=1
# VISION_MODEL=qwen3.7-flash

# ===== 多 Agent 对照实验参数 =====
MAX_HOPS=5
PLAN_ROUTING=1
DIRECT_REPLY=1

# ===== 可选：LangSmith 链路追踪 =====
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_xxx
# LANGSMITH_PROJECT=ecom-cs-agent
